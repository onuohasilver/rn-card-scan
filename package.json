{
  "name": "@onuohasilver/rn-card-scan",
  "version": "0.1.0",
  "description": "React Native card scan SDK with on-device OCR and liveness checks",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "ios",
    "android",
    "rn-card-scan.podspec",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react-native-vision-camera --external react --external react-native",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-vision-camera": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-vision-camera": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
